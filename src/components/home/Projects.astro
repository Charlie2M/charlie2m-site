---
import { projects } from '../../data/profile';
import { t, type Lang } from '../../i18n';
const d = t(Astro.props.lang as Lang);
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="sec-head">
      <span class="endpoint" data-reveal><span class="verb">GET</span>/projects</span>
      <h2 class="sec-title" id="projects-title" data-split>{d.projects.title}</h2>
      <p class="sec-lead" data-reveal>{d.projects.lead}</p>
    </div>
    <div class="projects__grid">
      {d.projects.items.map((p, i) => (
        <article class="project" data-tilt data-reveal>
          <div class="project__shine" aria-hidden="true" />
          <span class="project__idx">0{i + 1} / 0{d.projects.items.length}</span>
          <h3>{p.name}</h3>
          <span class="project__stack">{p.stack}</span>
          <p>{p.body}</p>
          <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
          <div class="console" data-console={JSON.stringify(projects[i].console)} aria-live="polite">
            <span class="console__idle">› _</span>
          </div>
          <div class="project__actions">
            <button class="btn btn--primary btn--sm" type="button" data-run data-rerun-label={d.projects.rerun}>▶ {d.projects.run}</button>
            <a class="btn btn--sm" href={projects[i].repo} target="_blank" rel="noopener">{d.projects.code} ↗</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
